generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Core Entities ---

model Organization {
  id             String   @id @default(cuid())
  name           String
  financingRate  Float    @default(0) // annual rate as decimal (e.g. 0.12 = 12%)
  settings       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users            User[]
  vendors          Vendor[]
  customers        Customer[]
  categories       Category[]
  storageLocations StorageLocation[]
  purchaseDeals    PurchaseDeal[]
  items            Item[]
  sales            Sale[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  role           UserRole @default(MEMBER)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("users")
}

model Vendor {
  id             String   @id @default(cuid())
  name           String
  contactEmail   String?
  contactPhone   String?
  notes          String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseDeals PurchaseDeal[]

  @@map("vendors")
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  contactEmail   String?
  contactPhone   String?
  notes          String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales        Sale[]

  @@map("customers")
}

model Category {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        Item[]

  @@map("categories")
}

model StorageLocation {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        Item[]

  @@map("storage_locations")
}

model PurchaseDeal {
  id             String   @id @default(cuid())
  vendorId       String
  organizationId String
  date           DateTime @default(now())
  totalPrice     Float
  fees           Float    @default(0)
  taxes          Float    @default(0)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vendor       Vendor       @relation(fields: [vendorId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        Item[]

  @@map("purchase_deals")
}

model Item {
  id                    String     @id @default(cuid())
  name                  String
  description           String?
  sku                   String?
  status                ItemStatus @default(ACQUIRED)
  categoryId            String?
  storageLocationId     String?
  purchaseDealId        String?
  organizationId        String
  allocatedPurchaseCost Float      @default(0)
  allocatedFees         Float      @default(0)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  category        Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  storageLocation StorageLocation?  @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)
  purchaseDeal    PurchaseDeal?     @relation(fields: [purchaseDealId], references: [id], onDelete: SetNull)
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  processingLogs  ItemProcessingLog[]
  saleLineItem    SaleLineItem?

  @@map("items")
}

model ItemProcessingLog {
  id          String   @id @default(cuid())
  itemId      String
  description String
  cost        Float
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("item_processing_logs")
}

model Sale {
  id             String   @id @default(cuid())
  customerId     String
  organizationId String
  date           DateTime @default(now())
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer  Customer       @relation(fields: [customerId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lineItems SaleLineItem[]

  @@map("sales")
}

model SaleLineItem {
  id        String @id @default(cuid())
  saleId    String
  itemId    String @unique
  salePrice Float

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id])

  @@map("sale_line_items")
}

// --- Enums ---

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ItemStatus {
  ACQUIRED
  PROCESSING
  LISTED
  SOLD
  RETURNED
}
